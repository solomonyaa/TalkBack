<Window x:Class="Talkback.GUI.Popup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Talkback.GUI"
        mc:Ignorable="d"
        Title="Confirm Resignation" Height="200" Width="200">
    <StackPanel Orientation="Vertical">
        <TextBlock Margin="10" FontSize="18" TextAlignment="Center" TextWrapping="WrapWithOverflow" Text="Are you sure you want to resign?" />
        <Button Content="Yes"/>
        <Button Content="Cancel"/>
    </StackPanel>
</Window>
