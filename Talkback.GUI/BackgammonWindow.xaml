<Window x:Class="Talkback.GUI.BackgammonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Talkback.GUI"
        mc:Ignorable="d"
        Loaded="MainWindow_OnLoaded"
        Title="Sela TalkBack"  Height="400" Width="600">
    <Window.Content>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>

                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Name="cnctNameLbl" Margin="5px 20px" TextWrapping="Wrap" TextAlignment="Center" Text="Contact Name"  Grid.Row="0" Grid.Column="4"/>

            <Button Name="RollBtn" Margin="20px"  Content="Roll" Click="Cubes_Clicked" Grid.Row="1" Grid.Column="4"/>
            <StackPanel  HorizontalAlignment="Center" Orientation="Horizontal" Grid.Row="2" Grid.Column="4">
                <Image Height="25" Name="currentPlayerColor"/>
                <Label Name="Turn" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Turn" />

            </StackPanel>
            <Button Click="forfeitBtn_Click" Name="forfeitBtn" Margin="20px"  Content="Forfeit"  Grid.Row="3" Grid.Column="4"/>
            <ComboBox SelectionChanged="onlinePlayersCB_SelectionChanged" Margin="0px 20px" Name="onlinePlayersCB" Grid.Column="5" Grid.ColumnSpan="2" Grid.Row="0"/>
            <ListView Name="msgSP"  Grid.Row="1" Grid.RowSpan="3" Grid.Column="5" Grid.ColumnSpan="2">

            </ListView>
            <StackPanel Name="sendMsgPaneSP" Visibility="Visible" HorizontalAlignment="Stretch" Grid.Row="4" Grid.RowSpan="2" Grid.Column="5" Grid.ColumnSpan="2" Orientation="Horizontal">
                <TextBox x:Name="SendMsgTB" FontSize="15" TextAlignment="Justify" Width="130"  Height="50" TextChanged="SendMsgTB_TextChanged" />
                <Button Click="SendMsgBtn_Click" FontSize="10" Margin="5px 20px" IsEnabled="False" x:Name="SendMsgBtn"  Content="Send"/>
            </StackPanel>
            <TextBlock Visibility="Hidden" Name="gameResultTB" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" Text="You Won!" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Background="White" />
            <Grid  Name="BackgammonBoard"  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border BorderThickness="1" BorderBrush="Black">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Label Content="0" x:Name="TextCube1"/>
                        <Label Content="0" x:Name="TextCube2"/>
                    </StackPanel>
                </Border>

                    <Grid Name="BoardGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                </Grid>





            </Grid>
        </Grid>
    </Window.Content>

</Window>
